# ---- Server ----
PORT=3004
NODE_ENV=development

# ---- PostgreSQL (auth data) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=ecommerce_auth

# ---- MongoDB (products + cart) ----
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_PRODUCT=product
MONGODB_CART=shopping-cart

# ---- JWT ----
JWT_SECRET=replace-with-a-long-random-secret

# ---- Google OAuth 2.0 ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3004/auth/google/callback
GOOGLE_LINKING_CALLBACK_URL=http://localhost:3004/auth/link/google/callback

# ---- Razorpay (test mode) ----
API_KEY_ID=rzp_test_your_key_id
SECRET_KEY=your_razorpay_key_secret


# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Misc ----
# Base URL used by the /payment/test checkout page
API_BASE_URL=http://localhost:3004
